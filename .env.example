# Environment Variables
# Copy this file to .env and fill in your values

# Application
NEXT_PUBLIC_APP_NAME=TaskFlow
NEXT_PUBLIC_APP_VERSION=1.0.0

# API Configuration (future)
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Analytics (future)
# NEXT_PUBLIC_GA_ID=UA-XXXXXXXXX-X
# NEXT_PUBLIC_SENTRY_DSN=

# Feature Flags
NEXT_PUBLIC_ENABLE_DRAG_DROP=true
NEXT_PUBLIC_ENABLE_KEYBOARD_SHORTCUTS=true
NEXT_PUBLIC_ENABLE_EXPORT=true
NEXT_PUBLIC_ENABLE_IMPORT=true
NEXT_PUBLIC_ENABLE_CALENDAR=false
NEXT_PUBLIC_ENABLE_COLLABORATION=false
NEXT_PUBLIC_ENABLE_AUTH=false
NEXT_PUBLIC_ENABLE_CLOUD_SYNC=false

# Theme
NEXT_PUBLIC_DEFAULT_THEME=system
NEXT_PUBLIC_DEFAULT_LANGUAGE=fr

# Notifications (future)
# NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
# NEXT_PUBLIC_ENABLE_EMAIL_NOTIFICATIONS=false
# NEXT_PUBLIC_ENABLE_SOUND_EFFECTS=true

# Storage
NEXT_PUBLIC_STORAGE_TYPE=local # local, cloud

# Development
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
